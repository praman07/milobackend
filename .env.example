# ── REQUIRED ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# Your deployed Vercel frontend URL (no trailing slash)
CLIENT_URL=https://your-app.vercel.app

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://your-app.vercel.app

# Google OAuth – https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match exactly what you register in Google Console
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# Session & JWT secrets – generate strong random strings (e.g. openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-strong-random-secret
JWT_SECRET=change-me-to-a-strong-random-secret

# Supabase – copy from: supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OPTIONAL ──────────────────────────────────────────────────────────────────
# Redis for matchmaking (falls back to in-memory if omitted)
# REDIS_URL=redis://...
